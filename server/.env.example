# Copy to .env in this directory:
#   cp .env.example .env
# Then: go run ./cmd/gamedb

# Required. Shared password for the web UI and iOS app.
APP_PASSWORD=change-me

# Optional. Directory for SQLite + cached cover art.
# Relative paths are from the process working directory (this folder if you
# `cd server` first). ../data is the repo-level data/ directory.
DATA_DIR=../data

# Optional. Listen address. Default: :8080
HTTP_ADDR=:8080

# Optional. Set to 1 if the app is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=0

# IGDB (Twitch) credentials. Search is disabled until both are set.
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional. TheGamesDB API key for platform-specific physical box fronts.
# Free key: https://thegamesdb.net/api.php
# THEGAMESDB_API_KEY=

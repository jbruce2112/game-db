# Required. Shared password for the web UI and iOS app.
APP_PASSWORD=change-me

# Optional. Directory for SQLite + cached cover art. Default: ./data
DATA_DIR=./data

# Optional. Listen address. Default: :8080
HTTP_ADDR=:8080

# Optional. Set to 1 if the app is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=0

# IGDB (Twitch) credentials. Search is disabled until both are set.
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

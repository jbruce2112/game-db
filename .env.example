# Required. Shared password for the web UI and iOS app.
APP_PASSWORD=change-me

# Optional. Directory for SQLite + cached cover art. Default: ./data
DATA_DIR=./data

# Docker Compose: host port published on the LAN. Default 8080.
# HTTP_ADDR inside the container stays :8080; this only changes the outside port.
HTTP_PORT=8080

# Local `go run` only: process listen address. Compose overrides this to :8080.
# Do not set 127.0.0.1 if other devices should connect.
HTTP_ADDR=:8080

# Optional. Set to 1 if the app is served over HTTPS so the session cookie is Secure.
COOKIE_SECURE=0

# IGDB (Twitch) credentials. Search is disabled until both are set.
# https://api-docs.igdb.com/#getting-started
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional. PriceCharting API token (Legendary subscription).
# https://www.pricecharting.com/api-documentation
PRICECHARTING_TOKEN=
